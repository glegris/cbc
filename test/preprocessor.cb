import stdio;

#define LOG(fmt, ...) printf(fmt, __VA_ARGS__)
#define LOG0(fmt, ...) printf(fmt, ##__VA_ARGS__)
#define XSTR(x) STR(x)
#define STR(x) #x

int
main(int argc, char **argv)
{
        LOG("%d;", 42);
        LOG0("noargs;");
        LOG0("witharg:%d;", 7);
        printf(XSTR(__STDC__) ";");
        printf("%d;", __COUNTER__);
        printf("%d;", __COUNTER__);
#line 1000
        printf("%d\n", __LINE__);
        return 0;
}
