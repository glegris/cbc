DoWhileNode dowhile_stmt():
{
    Token t;
    ExprNode cond;
    StmtNode body;
}
{
    t=<DO> body=stmt() <WHILE> "(" cond=expr() ")" ";"
        {
            return new DoWhileNode(location(t), body, cond);
        }
}

// A for-loop's init-clause can be a declaration (C99), e.g.
// "for (int i = 0; i < n; i++)"; the declared variable(s) must only be
// visible for the loop (not the enclosing block) and initialize before
// the loop's first condition check, so this desugars to exactly what
// that C99 form means: a block containing the declaration(s) followed
// by the loop itself (with an empty init-clause, since the declaration
// already initialized the variable) -- reusing BlockNode's existing
// scope/initializer machinery rather than adding a new one to ForNode.
StmtNode for_stmt():
{
    Token t;
    List<DefinedVariable> initDecls = null;
    ExprNode init = null, cond = null, incr = null;
    StmtNode body;
}
{
    t=<FOR> "("
              ( LOOKAHEAD(storage() type() <IDENTIFIER>)
                initDecls=defvars_body()
              | [init=expr()]
              )
              ";"
              [cond=expr()] ";"
              [incr=expr()] ")" body=stmt()
        {
            ForNode forNode = new ForNode(location(t), init, cond, incr, body);
            if (initDecls == null) {
                return forNode;
            }
            List<StmtNode> blockStmts = new ArrayList<StmtNode>();
            for (DefinedVariable v : initDecls) {
                if (v.hasInitializer()) {
                    blockStmts.add(new DefvarNode(v));
                }
            }
            blockStmts.add(forNode);
            return new BlockNode(location(t), initDecls, blockStmts);
        }
}

SwitchNode switch_stmt():
{
    Token t;
    ExprNode cond;
    List<CaseNode> bodies;
}
{
    t=<SWITCH> "(" cond=expr() ")" "{" bodies=case_clauses() "}"
        {
            return new SwitchNode(location(t), cond, bodies);
        }
}

List<CaseNode> case_clauses():
{
    List<CaseNode> clauses = new ArrayList<CaseNode>();
    CaseNode n;
}
{
    (n=case_clause() { clauses.add(n); })*
            [n=default_clause() { clauses.add(n); }]
        {
            return clauses;
        }
}

CaseNode case_clause():
{
    List<ExprNode> values;
    BlockNode body;
}
{
    values=cases() body=case_body()
        {
            return new CaseNode(body.location(), values, body);
        }
}

List<ExprNode> cases():
{
    List<ExprNode> values = new ArrayList<ExprNode>();
    ExprNode n;
}
{
    (<CASE> n=primary() ":" { values.add(n); })+
        {
            return values;
        }
}

CaseNode default_clause():
{ BlockNode body; }
{
    <DEFAULT_> ":" body=case_body()
        {
            return new CaseNode(body.location(), new ArrayList<ExprNode>(), body);
        }
}

BlockNode case_body():
{
    LinkedList<StmtNode> stmts = new LinkedList<StmtNode>();
    StmtNode s;
    Token t;
}
{
        { t = getToken(1); }
    (s=stmt() { if (s != null) stmts.add(s); })*
        {
            // A case clause with no "break" at the end falls through
            // into the next one, same as real C switch statements (see
            // IRGenerator#visit(SwitchNode): case bodies are already
            // emitted as one straight-line sequence of labeled
            // statements, so falling through was always what the IR
            // naturally did here -- only this "must end in break" parser
            // restriction ever prevented it).
            return new BlockNode(location(t),
                                 new ArrayList<DefinedVariable>(),
                                 stmts);
        }
}

