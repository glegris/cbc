// #@@range/options{
options {
    STATIC = false;
    DEBUG_PARSER = true;
    UNICODE_INPUT = true;
    JDK_VERSION = "1.5";
}
// #@@}

PARSER_BEGIN(Parser)
package net.loveruby.cflat.parser;
import net.loveruby.cflat.ast.*;
import net.loveruby.cflat.entity.*;
import net.loveruby.cflat.type.*;
import net.loveruby.cflat.asm.Label;
import net.loveruby.cflat.utils.ErrorHandler;
import net.loveruby.cflat.exception.*;
import java.lang.reflect.*;
import java.util.*;
import java.io.*;

public class Parser {
    static public AST parseFile(File file, List<String> includePaths,
                                ErrorHandler errorHandler)
                                throws SyntaxException, FileException {
        return parseFile(file, includePaths, errorHandler, false);
    }

    // #@@range/parseFile{
    static public AST parseFile(File file, List<String> includePaths,
                                ErrorHandler errorHandler, boolean debug)
                                throws SyntaxException, FileException {
        return newFileParser(file, includePaths, errorHandler, debug).parse();
    }
    // #@@}

    // #@@range/newFileParser{
    static final public String SOURCE_ENCODING = "UTF-8";

    static public Parser newFileParser(File file,
                                       List<String> includePaths,
                                       ErrorHandler errorHandler,
                                       boolean debug)
                                       throws FileException {
        String src = new net.loveruby.cflat.cpp.Preprocessor(
                includePaths, errorHandler).preprocessFile(file);
        Reader r = new StringReader(src);
        return new Parser(r, file.getPath(), errorHandler, debug);
    }
    // #@@}

    // #@@range/instance_members{
    private String sourceName;
    private ErrorHandler errorHandler;
    private Set<String> knownTypedefs;
    // Where a struct/union/enum defined *inside* a function body (see
    // block()) gets hoisted to -- the same Declarations top_defs() is
    // building for the whole file, so it's registered exactly like a
    // top-level one (same flat, file-wide struct/union/enum-tag
    // namespace; see README.md for the resulting scoping caveat).
    private Declarations topDecls = new Declarations();
    // #@@}

    // #@@range/ctor1{
    public Parser(Reader s, String name, ErrorHandler errorHandler) {
        this(s, name, errorHandler, false);
    }
    // #@@}

    // #@@range/ctor2{
    public Parser(Reader s, String name,
                  ErrorHandler errorHandler, boolean debug) {
        this(s);
        this.sourceName = name;
        this.errorHandler = errorHandler;
        this.knownTypedefs = new HashSet<String>();
        if (debug) {
            enable_tracing();
        }
        else {
            disable_tracing();
        }
    }
    // #@@}

    // #@@range/parse{
    public AST parse() throws SyntaxException {
        try {
            return compilation_unit();
        }
        catch (TokenMgrError err) {
            throw new SyntaxException(err.getMessage());
        }
        catch (ParseException ex) {
            throw new SyntaxException(ex.getMessage());
        }
        catch (LookaheadSuccess err) {
            throw new SyntaxException("syntax error");
        }
    }
    // #@@}

    private void addType(String name) {
        knownTypedefs.add(name);
    }

    private boolean isType(String name) {
        return knownTypedefs.contains(name);
    }

    // #@@range/newReader{
    private IntegerLiteralNode integerNode(Location loc, String image) {
        long i = integerValue(image);
        String upper = image.toUpperCase();
        int suffixStart = upper.length();
        while (suffixStart > 0 &&
                (upper.charAt(suffixStart - 1) == 'U'
                        || upper.charAt(suffixStart - 1) == 'L')) {
            suffixStart--;
        }
        String suffix = upper.substring(suffixStart);
        boolean unsigned = suffix.indexOf('U') >= 0;
        int lCount = 0;
        for (int idx = 0; idx < suffix.length(); idx++) {
            if (suffix.charAt(idx) == 'L') lCount++;
        }
        if (unsigned && lCount >= 2) {
            return new IntegerLiteralNode(loc, IntegerTypeRef.ulonglongRef(), i);
        }
        else if (unsigned && lCount == 1) {
            return new IntegerLiteralNode(loc, IntegerTypeRef.ulongRef(), i);
        }
        else if (unsigned) {
            return new IntegerLiteralNode(loc, IntegerTypeRef.uintRef(), i);
        }
        else if (lCount >= 2) {
            return new IntegerLiteralNode(loc, IntegerTypeRef.longlongRef(), i);
        }
        else if (lCount == 1) {
            return new IntegerLiteralNode(loc, IntegerTypeRef.longRef(), i);
        }
        else {
            return integerNodeWithoutSuffix(loc, image, i);
        }
    }

    // C99 6.4.4.1's own value-based fallback table for a suffix-less
    // integer constant: decimal tries int then long long (no unsigned
    // fallback for decimal); octal/hex try int, unsigned int, long long,
    // then unsigned long long. "long" itself is deliberately skipped in
    // both chains -- its width is platform-dependent (4 bytes on
    // ilp32/llp64, 8 on lp64/ilp64; see TypeTable) and the parser runs
    // before any target is picked, whereas "int" (always 4 bytes) and
    // "long long" (always >=64 bits) are fixed-width on every profile
    // this compiler supports, so only those can be chosen safely here --
    // this never picks a type too narrow for the literal's value, only
    // possibly wider than strict C99 would on an LP64-like target.
    private IntegerLiteralNode integerNodeWithoutSuffix(
            Location loc, String image, long i) {
        boolean isHexOrOctal = image.startsWith("0x") || image.startsWith("0X")
                || (image.startsWith("0") && !image.equals("0"));
        if (isHexOrOctal) {
            if (i >= 0 && i <= 0x7fffffffL) {
                return new IntegerLiteralNode(loc, IntegerTypeRef.intRef(), i);
            }
            else if (i >= 0 && i <= 0xffffffffL) {
                return new IntegerLiteralNode(loc, IntegerTypeRef.uintRef(), i);
            }
            else if (i >= 0) {
                return new IntegerLiteralNode(loc, IntegerTypeRef.longlongRef(), i);
            }
            else {
                return new IntegerLiteralNode(loc, IntegerTypeRef.ulonglongRef(), i);
            }
        }
        else {
            if (i >= 0 && i <= 0x7fffffffL) {
                return new IntegerLiteralNode(loc, IntegerTypeRef.intRef(), i);
            }
            else {
                // integerValue() parses decimal with a signed parseLong,
                // so a successfully-parsed "i" here is always within
                // long long's (== Java long's) own signed range already.
                return new IntegerLiteralNode(loc, IntegerTypeRef.longlongRef(), i);
            }
        }
    }
    // #@@}

    // #@@range/buildEnumDecls{
    /** An enum is just sugar over int here: each enumerator becomes a
     *  top-level named int constant (reusing the existing "const"
     *  machinery), and the enum's own tag name becomes a typedef alias
     *  for int (reusing the existing typedef machinery) -- so "enum
     *  Color" and "Color" both work as a type afterward, and no new
     *  Type/Entity classes are needed at all. */
    private Declarations buildEnumDecls(Location loc, String enumName,
            List<String> names, List<ExprNode> values) throws ParseException {
        Declarations decls = new Declarations();
        Long next = 0L;
        for (int i = 0; i < names.size(); i++) {
            String memberName = names.get(i);
            ExprNode value = values.get(i);
            ExprNode constValue;
            if (value != null) {
                constValue = value;
                if (value instanceof IntegerLiteralNode) {
                    next = ((IntegerLiteralNode)value).value() + 1;
                }
                else {
                    // Any constant expression is accepted as an
                    // enumerator's own value (same leniency as a plain
                    // "const"), but auto-incrementing after it would
                    // require evaluating it now, which this parser
                    // can't do in general -- so the *next* enumerator
                    // must also have an explicit value.
                    next = null;
                }
            }
            else {
                if (next == null) {
                    throw new ParseException("enum " + enumName + ": enumerator '"
                            + memberName + "' needs an explicit value (cannot "
                            + "auto-increment after a non-literal enumerator value)");
                }
                constValue = new IntegerLiteralNode(loc, IntegerTypeRef.intRef(), next);
                next = next + 1;
            }
            decls.addConstant(new Constant(new TypeNode(IntegerTypeRef.intRef()),
                    memberName, constValue));
        }
        decls.addTypedef(new TypedefNode(loc, IntegerTypeRef.intRef(), enumName));
        return decls;
    }
    // #@@}

    // #@@range/floatNode{
    private FloatLiteralNode floatNode(Location loc, String image) {
        if (image.endsWith("f") || image.endsWith("F")) {
            return new FloatLiteralNode(loc, FloatTypeRef.floatRef(),
                    floatValue(image));
        }
        else {
            // A plain or "L"-suffixed floating constant is a double in
            // C99 (there is no distinct "long double" type here; see the
            // JVM backend's class comment for the current scope).
            return new FloatLiteralNode(loc, FloatTypeRef.doubleRef(),
                    floatValue(image));
        }
    }
    // #@@}

    // #@@range/floatValue{
    private double floatValue(String image) {
        String s = image.replaceFirst("[fFlL]$", "");
        return Double.parseDouble(s);
    }
    // #@@}

    // #@@range/integerValue{
    private long integerValue(String image) {
        // Case-insensitive and anchored to the end: a lowercase suffix
        // ("100ul") must strip just as cleanly as an uppercase one, and
        // anchoring avoids ever touching a hex digit before it (hex
        // digits are 0-9a-fA-F, which never includes 'u'/'l', but being
        // explicit here costs nothing).
        String s = image.replaceFirst("(?i)[ul]+$", "");
        if (s.startsWith("0x") || s.startsWith("0X")) {
            // A hex constant (unlike a decimal one -- C99 6.4.4.1p5's
            // own table) is allowed to pick an unsigned type when it
            // doesn't fit a signed one, so e.g. "0xffffffffffffffff"
            // (ULLONG_MAX, a common all-ones bit pattern/bitmask) is a
            // perfectly valid literal, not an overflow -- parseUnsignedLong
            // parses the full 64-bit range and hands back its raw bit
            // pattern (cbc's own internal "long" is just a bit pattern;
            // signedness is tracked separately, by the surrounding
            // Type), where plain parseLong would throw
            // NumberFormatException for anything past 0x7fffffffffffffff.
            return Long.parseUnsignedLong(s.substring(2), 16);
        }
        else if (s.startsWith("0") && !s.equals("0")) {
            // Same reasoning as hex above -- an octal constant gets the
            // same unsigned-fallback treatment in C99's own table.
            return Long.parseUnsignedLong(s.substring(1), 8);
        }
        else {
            return Long.parseLong(s, 10);
        }
    }
    // #@@}

    // #@@range/withArrayDims{
    // A real C declarator's own "[N]"/"[]" suffixes attach to the
    // *name* being declared, not to the type keyword before it (unlike
    // "*", which -- in this grammar's simplified declarator syntax --
    // always sits right after the type keyword and before the name, so
    // typeref()'s own postfix loop already handles it there). This
    // builds the actual array type once arraySuffix() has collected
    // each "[N]"/"[]" a declarator wrote, left-to-right as written
    // (e.g. "arr[2][3]" -> [2, 3]), nesting them innermost-last so the
    // result is genuinely "array of 2 (array of 3 (elemType))", not
    // the other way around.
    private TypeRef withArrayDims(TypeRef elementType, List<Long> dims) {
        TypeRef ref = elementType;
        for (int i = dims.size() - 1; i >= 0; i--) {
            Long dim = dims.get(i);
            ref = (dim == null) ? new ArrayTypeRef(ref) : new ArrayTypeRef(ref, dim);
        }
        return ref;
    }
    // #@@}

    // #@@range/declaratorType{
    // One declarator's own final type in a "T d1, d2, ...;" list: its
    // own array dims (if any -- see withArrayDims()) applied first,
    // then any "const"/"volatile" shared by the whole declaration --
    // matching the order type() itself already used (qualifying the
    // *whole* type, e.g. "T *p" becoming a const pointer rather than a
    // pointer to const T; a pre-existing simplification, not something
    // this per-declarator handling changes).
    private TypeNode declaratorType(TypeRef ref, List<Long> dims,
            boolean isConst, boolean isVolatile) {
        if (! dims.isEmpty()) {
            ref = withArrayDims(ref, dims);
        }
        if (isConst || isVolatile) {
            ref = new QualifiedTypeRef(ref, isConst, isVolatile);
        }
        return new TypeNode(ref);
    }
    // #@@}

    // #@@range/characterCode{
    private long characterCode(String image) throws ParseException {
        String s = stringValue(image);
        if (s.length() != 1) {
            throw new Error("must not happen: character length > 1");
        }
        return (long)s.charAt(0);
    }
    // #@@}

    // #@@range/stringValue{
    private String stringValue(String _image) throws ParseException {
        int pos = 0;
        int idx;
        StringBuffer buf = new StringBuffer();
        String image = _image.substring(1, _image.length() - 1);

        while ((idx = image.indexOf("\\", pos)) >= 0) {
            buf.append(image.substring(pos, idx));
            if (image.length() >= idx + 4
                    && Character.isDigit(image.charAt(idx+1))
                    && Character.isDigit(image.charAt(idx+2))
                    && Character.isDigit(image.charAt(idx+3))) {
                buf.append(unescapeOctal(image.substring(idx+1, idx+4)));
                pos = idx + 4;
            }
            else {
                buf.append(unescapeSeq(image.charAt(idx+1)));
                pos = idx + 2;
            }
        }
        if (pos < image.length()) {
            buf.append(image.substring(pos, image.length()));
        }
        return buf.toString();
    }
    // #@@}

    private TypeRef size_t() {
        return IntegerTypeRef.ulongRef();
    }

    // #@@range/unescapeOctal{
    private static final int charMax = 255;

    private char unescapeOctal(String digits) throws ParseException {
        int i = Integer.parseInt(digits, 8);
        if (i > charMax) {
            throw new ParseException(
                "octal character sequence too big: \\" + digits);
        }
        return (char)i;
    }
    // #@@}

    // #@@range/unescapeSeq{
    private static final char bell = 7;
    private static final char backspace = 8;
    private static final char escape = 27;
    private static final char vt = 11;

    private char unescapeSeq(char c) throws ParseException {
        switch (c) {
        case '0': return '\0';
        case '"': return '"';
        case '\'': return '\'';
        case 'a': return bell;
        case 'b': return backspace;
        case 'e': return escape;
        case 'f': return '\f';
        case 'n': return '\n';
        case 'r': return '\r';
        case 't': return '\t';
        case 'v': return vt;
        default:
            throw new ParseException("unknown escape sequence: \"\\" + c);
        }
    }
    // #@@}

    // #@@range/location{
    protected Location location(Token t) {
        return new Location(sourceName, t);
    }
    // #@@}

    /** One step of a "{...}" element's C99 designator-list: either
     *  ".member" or "[index]" (the array index already folded to a
     *  compile-time constant -- see evalConstIndex()). A "{...}" element
     *  can carry a whole chain of these ("[i].member = x", ".a.b = x"),
     *  unlike the single member/index pair AggregateLiteralNode itself
     *  stores per element -- buildAggregateLiteral() below desugars a
     *  chain into nested, synthetic AggregateLiteralNode instances so
     *  the rest of the compiler never has to know the difference. */
    static abstract class Designator {
        static final class Member extends Designator {
            final String name;
            Member(String name) { this.name = name; }
            public boolean equals(Object o) {
                return o instanceof Member && ((Member) o).name.equals(name);
            }
            public int hashCode() { return name.hashCode(); }
        }
        static final class Index extends Designator {
            final long value;
            Index(long value) { this.value = value; }
            public boolean equals(Object o) {
                return o instanceof Index && ((Index) o).value == value;
            }
            public int hashCode() { return Long.valueOf(value).hashCode(); }
        }
    }

    /** One "{...}" element as written: its full designator path (empty
     *  for a plain, undesignated element) and its value. */
    static class RawDesignatedElem {
        List<Designator> path;
        ExprNode value;

        RawDesignatedElem(List<Designator> path, ExprNode value) {
            this.path = path;
            this.value = value;
        }
    }

    /** Evaluates a "[...]" array-designator index to a compile-time
     *  constant (C99 6.7.9p4 requires an "integer constant expression"
     *  there, not just the bare literal this parser used to require).
     *  Deliberately narrow -- literals plus the usual arithmetic/
     *  bitwise/shift/relational/logical/conditional operators, nested
     *  arbitrarily deep and folded right here at parse time -- rather
     *  than a full constant-expression evaluator that also chases named
     *  constants (an enum member, a "const" variable): those aren't
     *  resolved to an actual value until well after parsing (see
     *  LocalResolver), by which point this designator would already
     *  need its final position to build the literal's element list. */
    private long evalConstIndex(ExprNode e) throws ParseException {
        if (e instanceof IntegerLiteralNode) {
            return ((IntegerLiteralNode) e).value();
        }
        if (e instanceof UnaryOpNode) {
            UnaryOpNode u = (UnaryOpNode) e;
            long v = evalConstIndex(u.expr());
            String op = u.operator();
            if (op.equals("+")) return v;
            if (op.equals("-")) return -v;
            if (op.equals("~")) return ~v;
            if (op.equals("!")) return (v == 0) ? 1 : 0;
        }
        else if (e instanceof BinaryOpNode) {
            BinaryOpNode b = (BinaryOpNode) e;
            long l = evalConstIndex(b.left());
            long r = evalConstIndex(b.right());
            String op = b.operator();
            if (op.equals("+"))  return l + r;
            if (op.equals("-"))  return l - r;
            if (op.equals("*"))  return l * r;
            if (op.equals("/"))  return l / r;
            if (op.equals("%"))  return l % r;
            if (op.equals("<<")) return l << r;
            if (op.equals(">>")) return l >> r;
            if (op.equals("&"))  return l & r;
            if (op.equals("|"))  return l | r;
            if (op.equals("^"))  return l ^ r;
            if (op.equals("&&")) return (l != 0 && r != 0) ? 1 : 0;
            if (op.equals("||")) return (l != 0 || r != 0) ? 1 : 0;
            if (op.equals("==")) return (l == r) ? 1 : 0;
            if (op.equals("!=")) return (l != r) ? 1 : 0;
            if (op.equals("<"))  return (l <  r) ? 1 : 0;
            if (op.equals(">"))  return (l >  r) ? 1 : 0;
            if (op.equals("<=")) return (l <= r) ? 1 : 0;
            if (op.equals(">=")) return (l >= r) ? 1 : 0;
        }
        else if (e instanceof CondExprNode) {
            CondExprNode c = (CondExprNode) e;
            return (evalConstIndex(c.cond()) != 0)
                    ? evalConstIndex(c.thenExpr()) : evalConstIndex(c.elseExpr());
        }
        throw new ParseException("array index designator must be a compile-time "
                + "integer constant expression (named constants like enum "
                + "members or \"const\" variables are not supported there)");
    }

    /** Builds one "{...}" level's element list from its raw designated
     *  elements, desugaring any chained designator ("[i].member = x",
     *  ".a.b = x") into a synthetic nested AggregateLiteralNode so that
     *  AggregateLiteralNode itself only ever has to represent a single
     *  member-or-index designator per element (see resolvePositions()
     *  there). Two elements sharing the same leading designator (e.g.
     *  "[1].a = 1, [1].b = 2") are merged into one synthetic element at
     *  that position; a later plain (unchained) designator for a
     *  position already seen overwrites it outright, matching C99's own
     *  "last designator for a spot wins" rule. */
    private AggregateLiteralNode buildAggregateLiteral(Location loc,
            List<RawDesignatedElem> raw) {
        List<ExprNode> elems = new ArrayList<ExprNode>();
        List<String> members = new ArrayList<String>();
        List<Long> indices = new ArrayList<Long>();
        Map<Designator, Integer> slotOf = new HashMap<Designator, Integer>();
        Map<Designator, List<RawDesignatedElem>> pending
                = new LinkedHashMap<Designator, List<RawDesignatedElem>>();

        for (RawDesignatedElem e : raw) {
            if (e.path.isEmpty()) {
                elems.add(e.value);
                members.add(null);
                indices.add(null);
                continue;
            }
            Designator head = e.path.get(0);
            List<Designator> rest = e.path.subList(1, e.path.size());
            Integer slot = slotOf.get(head);
            if (rest.isEmpty()) {
                if (slot == null) {
                    slot = elems.size();
                    elems.add(e.value);
                    members.add((head instanceof Designator.Member)
                            ? ((Designator.Member) head).name : null);
                    indices.add((head instanceof Designator.Index)
                            ? ((Designator.Index) head).value : null);
                    slotOf.put(head, slot);
                }
                else {
                    elems.set(slot, e.value);
                }
                pending.remove(head);
            }
            else {
                List<RawDesignatedElem> sub = pending.get(head);
                if (sub == null) {
                    sub = new ArrayList<RawDesignatedElem>();
                    pending.put(head, sub);
                    if (slot == null) {
                        slot = elems.size();
                        elems.add(null);
                        members.add((head instanceof Designator.Member)
                                ? ((Designator.Member) head).name : null);
                        indices.add((head instanceof Designator.Index)
                                ? ((Designator.Index) head).value : null);
                        slotOf.put(head, slot);
                    }
                    else {
                        elems.set(slot, null);
                    }
                }
                sub.add(new RawDesignatedElem(rest, e.value));
            }
        }
        for (Map.Entry<Designator, List<RawDesignatedElem>> ent : pending.entrySet()) {
            int slot = slotOf.get(ent.getKey());
            elems.set(slot, buildAggregateLiteral(loc, ent.getValue()));
        }
        return new AggregateLiteralNode(loc, elems, members, indices);
    }
}
PARSER_END(Parser)

/*
 * Lexical Rules
 */

// linear-white-spaces
// #@@range/lex_spaces{
SPECIAL_TOKEN: { <SPACES: ([" ", "\t", "\n", "\r", "\f"])+> }
// #@@}

// block comment
// #@@range/lex_block_comment{
MORE: { <"/*"> : IN_BLOCK_COMMENT }
<IN_BLOCK_COMMENT> MORE: { <~[]> }
<IN_BLOCK_COMMENT> SPECIAL_TOKEN: { <BLOCK_COMMENT: "*/"> : DEFAULT }
// #@@}

// line comment
// #@@range/lex_line_comment{
SPECIAL_TOKEN: {
    <LINE_COMMENT: "//" (~["\n", "\r"])* ("\n" | "\r\n" | "\r")?>
}
// #@@}

// reserved words
// #@@range/lex_reswords{
TOKEN: {
      <VOID     : "void">
    | <CHAR     : "char">
    | <SHORT    : "short">
    | <INT      : "int">
    | <LONG     : "long">
    | <FLOAT    : "float">
    | <DOUBLE   : "double">
    | <STRUCT   : "struct">
    | <UNION    : "union">
    | <ENUM     : "enum">
    | <STATIC   : "static">
    | <EXTERN   : "extern">
    | <CONST    : "const">
    | <VOLATILE : "volatile">
    | <SIGNED   : "signed">
    | <UNSIGNED : "unsigned">
    | <BOOL_    : "_Bool">
    | <INLINE   : "inline">
    | <RESTRICT : "restrict">
    | <IF       : "if">
    | <ELSE     : "else">
    | <SWITCH   : "switch">
    | <CASE     : "case">
    | <DEFAULT_ : "default">
    | <WHILE    : "while">
    | <DO       : "do">
    | <FOR      : "for">
    | <RETURN   : "return">
    | <BREAK    : "break">
    | <CONTINUE : "continue">
    | <GOTO     : "goto">
    | <TYPEDEF  : "typedef">
    | <SIZEOF   : "sizeof">
}
// #@@}

// identifier
// #@@range/lex_ident{
TOKEN: {
    <IDENTIFIER: ["a"-"z", "A"-"Z", "_"] (["a"-"z", "A"-"Z", "_", "0"-"9"])*>
}
// #@@}

// integer literals
// #@@range/lex_integer{
TOKEN: {
    <INTEGER: ["1"-"9"] (["0"-"9"])* (<INTSUFFIX>)?
            | "0" ["x", "X"] (["0"-"9", "a"-"f", "A"-"F"])+ (<INTSUFFIX>)?
            | "0" (["0"-"7"])* (<INTSUFFIX>)?
            >
    // A "long long" literal takes "LL" (e.g. "123456789012345LL"), same
    // as "L" alone already meant "long" -- in either order relative to
    // "U", matching real C99 ("100ULL", "100LLU", "100UL" and "100LU"
    // are all valid). integerValue()'s "[UL]+" strip already handles
    // whatever combination this matches, unchanged.
    //
    // Lowercase suffixes ("100ul", "5l", "7u", "100ull") are just as
    // idiomatic in real C as uppercase ones and must lex as *part of*
    // the integer literal, not as a separate (bogus) identifier token
    // right after it -- so "U"/"L" each need a lowercase alternative.
    // Per C99 6.4.4.1, "u"/"U" is chosen independently of the "l"/"L"
    // part, but a two-character "long long" suffix must use one case
    // consistently ("ll" or "LL", never "lL"/"Ll") -- <#LSUFFIX> below
    // captures exactly that.
    | <#INTSUFFIX: (["U","u"] (<LSUFFIX>)?) | (<LSUFFIX> (["U","u"])?)>
    | <#LSUFFIX: "LL" | "L" | "ll" | "l">
}
// #@@}

// floating-point literals
// #@@range/lex_float{
TOKEN: {
    <FLOATLIT: (["0"-"9"])+ "." (["0"-"9"])* (<EXPONENT>)? (["f","F","l","L"])?
             | "." (["0"-"9"])+ (<EXPONENT>)? (["f","F","l","L"])?
             | (["0"-"9"])+ <EXPONENT> (["f","F","l","L"])?
             // C99 hexadecimal floating constants, e.g. "0x1.8p3" (== 12.0):
             // a hex significand (unlike the decimal forms above, the
             // binary exponent is *mandatory* here, since without it
             // "0x1.8" would be indistinguishable from... nothing valid
             // in hex, but more importantly this keeps a plain hex
             // *integer* like "0x1A" unambiguously matched by <INTEGER>
             // instead -- JavaCC's longest-match rule only prefers this
             // token when a "p"/"P" exponent is actually present).
             | "0" ["x","X"] (["0"-"9","a"-"f","A"-"F"])+
                   "." (["0"-"9","a"-"f","A"-"F"])* <HEXEXPONENT> (["f","F","l","L"])?
             | "0" ["x","X"] "." (["0"-"9","a"-"f","A"-"F"])+ <HEXEXPONENT> (["f","F","l","L"])?
             | "0" ["x","X"] (["0"-"9","a"-"f","A"-"F"])+ <HEXEXPONENT> (["f","F","l","L"])?
             >
    | <#EXPONENT: ["e","E"] (["+","-"])? (["0"-"9"])+>
    | <#HEXEXPONENT: ["p","P"] (["+","-"])? (["0"-"9"])+>
}
// #@@}

// character literal
// #@@range/lex_char{
MORE: { <"'"> : IN_CHARACTER }                         // rule1
<IN_CHARACTER> MORE: {
      <~["'", "\\", "\n", "\r"]> : CHARACTER_TERM      // rule2
    | <"\\" (["0"-"7"]){3}>      : CHARACTER_TERM      // rule3
    | <"\\" ~[]>                 : CHARACTER_TERM      // rule4
}
<CHARACTER_TERM> TOKEN: { <CHARACTER: "'"> : DEFAULT } // rule5
// #@@}

// string literal
// #@@range/lex_string{
MORE: { <"\""> : IN_STRING }                           // rule1
<IN_STRING> MORE: {
      <(~["\"", "\\", "\n", "\r"])+>                   // rule2
    | <"\\" (["0"-"7"]){3}>                            // rule3
    | <"\\" ~[]>                                       // rule4
}
<IN_STRING> TOKEN: { <STRING: "\""> : DEFAULT }        // rule5
// #@@}

/*
 *  Grammar
 */

// #@@range/compilation_unit{
AST compilation_unit():
{
    Token t;
    Declarations decls;
}
{
        {
            t = getToken(1);
        }
    decls=top_defs() <EOF>
        {
            return new AST(location(t), decls);
        }
}
// #@@}

// #@@range/top_defs{
// A "#include"d header (already spliced in as plain text by the
// preprocessor, long before this ever runs) and the file that included
// it are parsed as one single, flat token stream, so this has to accept
// both real definitions (defun/defvars/...) *and* bare declarations
// (funcdecl/vardecl -- "extern int f(int);"/"extern int x;", a header's
// usual content) in the same repetition: there's no separate grammar
// entry point for "declarations only" the way a once-existed "import"
// system needed. funcdecl/vardecl are only ever reached when the next
// token is "extern" (storage() -- used by defun() -- never accepts it),
// so there's no real ambiguity to resolve beyond the lookahead already
// needed to tell "extern int f(int);" (a declaration) from
// "extern int f(int x)" followed by "{" (a definition), which this
// compiler has never actually supported (matching real C's own
// "extern" storage class on a function *definition* being legal but
// rare); the token immediately following the "extern" declaration
// forms determines which of the two it is far enough ahead for a plain
// LOOKAHEAD.
Declarations top_defs():
{
    Declarations decls = new Declarations();
    DefinedFunction defun;
    List<DefinedVariable> defvars;
    UndefinedFunction funcdecl;
    UndefinedVariable vardecl;
    Constant defconst;
    StructNode defstruct;
    UnionNode defunion;
    Declarations defenum;
    TypedefNode typedef;
}
{
        { topDecls = decls; }
    ( LOOKAHEAD(storage() typeref() <IDENTIFIER> "(")
      defun=defun()         { decls.addDefun(defun); }
    | LOOKAHEAD(<EXTERN> [<INLINE>] typeref() <IDENTIFIER> "(")
      funcdecl=funcdecl()   { decls.addFuncdecl(funcdecl); }
    | LOOKAHEAD(<EXTERN>)
      vardecl=vardecl()     { decls.addVardecl(vardecl); }
    | LOOKAHEAD(<CONST> type() <IDENTIFIER> "=")
      defconst=defconst()   { decls.addConstant(defconst); }
    | LOOKAHEAD(3)
      defvars=defvars()     { decls.addDefvars(defvars); }
    | defstruct=defstruct() { decls.addDefstruct(defstruct); }
    | defunion=defunion()   { decls.addDefunion(defunion); }
    | defenum=defenum()     { decls.add(defenum); }
    | typedef=typedef()     { decls.addTypedef(typedef); }
    )*
        {
            return decls;
        }
}
// #@@}

// #@@range/defvars{
List<DefinedVariable> defvars():
{
    List<DefinedVariable> defs;
}
{
    defs=defvars_body() ";"
        {
            return defs;
        }
}
// #@@}

// Same as defvars(), minus the trailing ";" -- shared with a for-loop's
// init-clause ("for (int i = 0; ...; ...)"), which has its own ";"
// right after the declaration.
List<DefinedVariable> defvars_body():
{
    List<DefinedVariable> defs = new ArrayList<DefinedVariable>();
    boolean priv;
    boolean isConst = false;
    boolean isVolatile = false;
    TypeRef coreRef;
    TypeRef declRef;
    TypeNode declType;
    String name;
    List<Long> dims;
    ExprNode init = null;
}
{
    priv=storage()
    ( <CONST> { isConst = true; } | <VOLATILE> { isVolatile = true; } )*
    coreRef=typeref_base()
    // Each declarator in a "T d1, d2, ...;" comma list re-applies its
    // *own* "*"/"[N]"/"[]" to the same shared base type ("coreRef"),
    // instead of every declarator after the first blindly inheriting
    // whatever the first declarator's own postfix happened to leave
    // behind (e.g. "int *p, q;" -- "q" must come out as plain "int",
    // not "int*") -- see typePostfix()/arraySuffix()/withArrayDims().
    declRef=typePostfix(coreRef) name=name() dims=arraySuffix()
        {
            declType = declaratorType(declRef, dims, isConst, isVolatile);
        }
    ["=" init=initializer()]
        {
            defs.add(new DefinedVariable(priv, declType, name, init));
            init = null;
        }
    ( "," declRef=typePostfix(coreRef) name=name() dims=arraySuffix()
        {
            declType = declaratorType(declRef, dims, isConst, isVolatile);
        }
      ["=" init=initializer()]
        {
            defs.add(new DefinedVariable(priv, declType, name, init));
            init = null;
        }
    )*
        {
            return defs;
        }
}

// #@@range/initializer{
// A variable's initializer: either a plain expression, or a brace-
// enclosed list (for an array/struct/union), which can itself nest
// (e.g. "{1, {2, 3}}" for an array of structs, or a multi-dim array).
ExprNode initializer():
{ ExprNode e; }
{
      e=aggregate_literal() { return e; }
    | e=expr()               { return e; }
}

AggregateLiteralNode aggregate_literal():
{
    Token t;
    List<RawDesignatedElem> raw = new ArrayList<RawDesignatedElem>();
    RawDesignatedElem d;
}
{
    t="{" d=designated_initializer()
        { raw.add(d); }
    ("," d=designated_initializer()
        { raw.add(d); }
    )*
    "}"
        {
            return buildAggregateLiteral(location(t), raw);
        }
}

// A "{...}" element, optionally led by a C99 designator-list: one or
// more ".member"/"[index]" steps (freely chained/nested, e.g.
// "[i].member =", ".a.b ="), each "[index]" a general compile-time
// integer constant expression (see evalConstIndex()) rather than just a
// plain literal. buildAggregateLiteral() (called once the whole "{...}"
// has been read, in aggregate_literal() above) desugars every element's
// path down to the single member-or-index designator per level that
// AggregateLiteralNode itself understands.
RawDesignatedElem designated_initializer():
{
    Token t;
    List<Designator> path = new ArrayList<Designator>();
    ExprNode idx;
    ExprNode e;
}
{
    ( ( "." t=<IDENTIFIER> { path.add(new Designator.Member(t.image)); }
      | "[" idx=expr10() "]" { path.add(new Designator.Index(evalConstIndex(idx))); }
      )+ "="
    )?
    e=initializer()
        {
            return new RawDesignatedElem(path, e);
        }
}
// #@@}

// #@@range/defconst{
Constant defconst():
{
    TypeNode type;
    String name;
    ExprNode value;
}
{
    <CONST> type=type() name=name() "=" value=expr() ";"
        {
            return new Constant(type, name, value);
        }
}
// #@@}

// #@@range/defun{
DefinedFunction defun():
{
    boolean priv;
    TypeRef ret;
    String n;
    Params ps;
    BlockNode body;
}
{
    priv=storage() ret=typeref() n=name() "(" ps=params() ")" body=block()
        {
            TypeRef t = new FunctionTypeRef(ret, ps.parametersTypeRef());
            return new DefinedFunction(priv, new TypeNode(t), n, ps, body);
        }
}
// #@@}

// #@@range/storage{
// "inline" (in either order relative to "static", as real C allows) is
// accepted and discarded -- a pure hint to the optimizer that neither
// backend acts on, same as "volatile" only parsing and propagating
// without actually changing codegen. This is intentionally permissive
// about *where* it's accepted (e.g. a local variable, not just a
// function): rejecting it there would need this production to know
// whether it's being called for a function or not, which it currently
// doesn't, and there's no codegen difference either way since it's
// always a no-op.
boolean storage():
{ boolean isStatic = false; }
{
    ( <STATIC> { isStatic = true; } | <INLINE> )*
        { return isStatic; }
}
// #@@}

// #@@range/storage{
Params params():
{
    Token t;
    Params params;
}
{
      LOOKAHEAD(<VOID> ")")
      t=<VOID>
        {
            return new Params(location(t), new ArrayList<CBCParameter>());
        }
      // A genuinely empty "()" -- as opposed to "(void)" -- is C89/C99's
      // own "unspecified parameter list" form (K&R's own, in fact): for a
      // function *definition* specifically (as opposed to a standalone
      // declaration), the standard says this means "takes no parameters"
      // (C99 6.7.5.3p14), exactly like "(void)"; this compiler treats it
      // that way uniformly for both a definition and a bare declaration
      // (rather than tracking the K&R distinction where a declaration's
      // "()" leaves call-site argument count/types unchecked), since
      // that's what every caller of a cflat function already needs
      // anyway. Without this, "int f() { ... }" -- extremely common,
      // idiomatic C, including "main()" itself -- failed to parse at
      // all: params() had no alternative at all for an empty list, only
      // "(void)" or "(at least one parameter)".
    | LOOKAHEAD(")")
        {
            return new Params(location(getToken(1)), new ArrayList<CBCParameter>());
        }
    | params=fixedparams()
            ["," "..." { params.acceptVarargs(); }]
        {
            return params;
        }
}
// #@@}

// #@@range/fixedparams{
Params fixedparams():
{
    List<CBCParameter> params = new ArrayList<CBCParameter>();
    CBCParameter param, param1;
}
{
    param1=param() { params.add(param1); }
    ( LOOKAHEAD(2) "," param=param() { params.add(param); } )*
        {
            return new Params(param1.location(), params);
        }
}
// #@@}

// #@@range/param{
CBCParameter param():
{
    TypeNode t;
    String n;
    List<Long> dims;
}
{
    t=type() n=name() dims=arraySuffix()
        {
            if (! dims.isEmpty()) {
                t = new TypeNode(withArrayDims(t.typeRef(), dims));
            }
            return new CBCParameter(t, n);
        }
}
// #@@}

// #@@range/block{
// A declaration can appear anywhere among a block's statements, not only
// at the top (C99 "mixed declarations and code"); each one still adds to
// the block's single flat variables() list (so scope resolution, type
// checking etc. -- which all just walk that list -- need no changes),
// but a DefvarNode marking its position is also threaded into stmts()
// for any variable with an initializer, so IRGenerator runs that
// initializer exactly where the declaration lexically appears, not
// always before the block's first statement. A variable's visibility
// still spans the whole enclosing block rather than starting only at its
// declaration point (a deliberate, documented simplification -- see
// README.md).
//
// A struct/union/enum can also be defined inside a function body now
// (also C99); it's hoisted straight into topDecls -- the very same
// Declarations top_defs() is building for the whole file -- so it's
// registered exactly like a top-level one, in the same flat, file-wide
// struct/union/enum-tag namespace (another documented simplification:
// real C99 would scope the tag to this block alone, so two functions
// could each define their own unrelated "struct Point" -- here the
// second definition of the same tag name anywhere in the file is a
// duplicate-type-definition error, same as two top-level ones would be).
BlockNode block():
{
    Token t;
    List<DefinedVariable> vars = new ArrayList<DefinedVariable>();
    List<StmtNode> stmts = new ArrayList<StmtNode>();
    List<DefinedVariable> declared;
    StructNode localStruct;
    UnionNode localUnion;
    Declarations localEnum;
    StmtNode s;
}
{
    t="{"
    ( LOOKAHEAD(storage() type() <IDENTIFIER>)
      declared=defvars()
        {
            vars.addAll(declared);
            for (DefinedVariable v : declared) {
                if (v.hasInitializer()) {
                    stmts.add(new DefvarNode(v));
                }
            }
        }
    | localStruct=defstruct() { topDecls.addDefstruct(localStruct); }
    | localUnion=defunion()   { topDecls.addDefunion(localUnion); }
    | localEnum=defenum()     { topDecls.add(localEnum); }
    | s=stmt() { if (s != null) stmts.add(s); }
    )*
    "}"
        {
            return new BlockNode(location(t), vars, stmts);
        }
}
// #@@}

// #@@range/defstruct{
StructNode defstruct():
{
    Token t;
    String n;
    List<Slot> membs;
}
{
    t=<STRUCT> n=name() membs=member_list() ";"
        {
            return new StructNode(location(t), new StructTypeRef(n), n, membs);
        }
}
// #@@}

UnionNode defunion():
{
    Token t;
    String n;
    List<Slot> membs;
}
{
    t=<UNION> n=name() membs=member_list() ";"
        {
            return new UnionNode(location(t), new UnionTypeRef(n), n, membs);
        }
}

// #@@range/defenum{
Declarations defenum():
{
    Token t;
    String n;
    List<String> names = new ArrayList<String>();
    List<ExprNode> values = new ArrayList<ExprNode>();
    String memberName;
    ExprNode memberValue;
}
{
    t=<ENUM> n=name()
        { addType(n); }
    "{"
    memberName=name()
        { names.add(memberName); values.add(null); }
    [ "=" memberValue=expr() { values.set(values.size() - 1, memberValue); } ]
    ( LOOKAHEAD(2) ","
      memberName=name()
        { names.add(memberName); values.add(null); }
      [ "=" memberValue=expr() { values.set(values.size() - 1, memberValue); } ]
    )*
    // C99 6.7.2.2p1 explicitly allows one trailing "," after the last
    // enumerator ("enum E { x, y, z, };"), same as an array/struct
    // aggregate literal already does elsewhere in this grammar.
    [ "," ]
    "}" ";"
        {
            return buildEnumDecls(location(t), n, names, values);
        }
}
// #@@}

// #@@range/member_list{
List<Slot> member_list():
{
    List<Slot> membs = new ArrayList<Slot>();
    Slot s;
}
{
    "{" (s=slot() ";" { membs.add(s); })* "}"
        {
            return membs;
        }
}
// #@@}

// #@@range/slot{
Slot slot():
{
    TypeNode t;
    String n;
    List<Long> dims;
}
{
    t=type() n=name() dims=arraySuffix()
        {
            if (! dims.isEmpty()) {
                t = new TypeNode(withArrayDims(t.typeRef(), dims));
            }
            return new Slot(t, n);
        }
}
// #@@}

// #@@range/funcdecl{
UndefinedFunction funcdecl():
{
    TypeRef ret;
    String n;
    Params ps;
}
{
    <EXTERN> [<INLINE>] ret=typeref() n=name() "(" ps=params() ")" ";"
        {
            TypeRef t = new FunctionTypeRef(ret, ps.parametersTypeRef());
            return new UndefinedFunction(new TypeNode(t), n, ps);
        }
}
// #@@}

UndefinedVariable vardecl():
{
    TypeNode t;
    String n;
    List<Long> dims;
}
{
    <EXTERN> t=type() n=name() dims=arraySuffix() ";"
        {
            if (! dims.isEmpty()) {
                t = new TypeNode(withArrayDims(t.typeRef(), dims));
            }
            return new UndefinedVariable(t, n);
        }
}

// #@@range/type{
TypeNode type():
{
    TypeRef ref;
    boolean isConst = false;
    boolean isVolatile = false;
}
{
    ( <CONST> { isConst = true; } | <VOLATILE> { isVolatile = true; } )*
    ref=typeref()
        {
            if (isConst || isVolatile) {
                ref = new QualifiedTypeRef(ref, isConst, isVolatile);
            }
            return new TypeNode(ref);
        }
}
// #@@}

// #@@range/typeref{
TypeRef typeref():
{
    TypeRef ref;
}
{
    ref=typeref_base()
    ref=typePostfix(ref)
        {
            return ref;
        }
}
// #@@}

// #@@range/typePostfix{
// The "[]"/"[N]"/"*"/"(params)" modifiers that can follow a base type
// keyword directly (e.g. "int *", "int[]", this project's own
// "int (char*)*" function-pointer spelling -- see funcptr.c). Factored
// out of typeref() so a single declarator (in a "T d1, d2, ...;" list)
// can re-apply it to the *same* shared base type instead of every
// declarator after the first blindly inheriting whatever the first
// declarator's own "*"/(...)" happened to leave in "ref" (e.g.
// "int *p, q;" -- "q" must come out as plain "int", not "int*").
TypeRef typePostfix(TypeRef base):
{
    TypeRef ref = base;
    Token t;
    ParamTypeRefs params;
}
{
    ( LOOKAHEAD(2)
      "[" "]"
        {
            ref = new ArrayTypeRef(ref);
        }
    | "[" t=<INTEGER> "]"
        {
            ref = new ArrayTypeRef(ref, integerValue(t.image));
        }
    | "*" [<RESTRICT>]
        {
            // "restrict" (e.g. "int *restrict p") only ever promises the
            // optimizer that no other pointer aliases the same memory --
            // it can't change what a conforming program observes, so
            // with no alias-based optimization here to enable, parsing
            // and discarding it is a complete, correct implementation.
            ref = new PointerTypeRef(ref);
        }
    | "(" params=param_typerefs() ")"
        {
            ref = new FunctionTypeRef(ref, params);
        }
    )*
        {
            return ref;
        }
}
// #@@}

// #@@range/param_typerefs{
ParamTypeRefs param_typerefs():
{ ParamTypeRefs params; }
{
      LOOKAHEAD(<VOID> ")")
      <VOID>
        {
            return new ParamTypeRefs(new ArrayList<TypeRef>());
        }
    | params=fixedparam_typerefs()
          [ "," "..."   { params.acceptVarargs(); }]
        {
            return params;
        }
}
// #@@}

// #@@range/fixedparam_typerefs{
ParamTypeRefs fixedparam_typerefs():
{
    List<TypeRef> refs = new ArrayList<TypeRef>();
    TypeRef ref;
}
{
    ref=typeref() { refs.add(ref); }
    ( LOOKAHEAD(2) "," ref=typeref() { refs.add(ref); } )*
        {
            return new ParamTypeRefs(refs);
        }
}
// #@@}

// #@@range/typeref_base{
// C99 6.7.2's integer type specifiers can combine "signed"/"unsigned"
// with "char"/"short"/"int"/"long"/"long long" and an optional trailing
// "int" in several equivalent ways (e.g. "long", "long int", "signed
// long", "signed long int" are all the exact same type) -- each of the
// three blocks below (bare, "signed"-prefixed, "unsigned"-prefixed)
// enumerates that same base-keyword shape explicitly, matching the
// style of the original (smaller) UNSIGNED-only version of this
// production, rather than factoring the shared shape into its own
// production (which would need to smuggle the matched base keyword,
// and "long" vs "long long"'s own distinction, back out through some
// side channel instead of a plain return value).
TypeRef typeref_base():
{
    Token t, name;
}
{
      t=<VOID>          { return new VoidTypeRef(location(t)); }
    | t=<FLOAT>         { return FloatTypeRef.floatRef(location(t)); }
    | t=<DOUBLE>        { return FloatTypeRef.doubleRef(location(t)); }
    | t=<BOOL_>         { return IntegerTypeRef.boolRef(location(t)); }
    | t=<STRUCT> name=<IDENTIFIER>
        { return new StructTypeRef(location(t), name.image); }
    | t=<UNION> name=<IDENTIFIER>
        { return new UnionTypeRef(location(t), name.image); }
    | t=<ENUM> name=<IDENTIFIER>
        { return new UserTypeRef(location(t), name.image); }
    | LOOKAHEAD({isType(getToken(1).image)}) name=<IDENTIFIER>
        { return new UserTypeRef(location(name), name.image); }
    // "signed ..." -- "signed" alone means plain "int"; "signed char"
    // is (unlike bare "char") *guaranteed* signed, which is already
    // how this compiler's own plain "char" behaves (see TypeTable), so
    // both map to the same charRef().
    | LOOKAHEAD(2) t=<SIGNED> <CHAR>
        { return IntegerTypeRef.charRef(location(t)); }
    | LOOKAHEAD(3) t=<SIGNED> <SHORT> <INT>
        { return IntegerTypeRef.shortRef(location(t)); }
    | LOOKAHEAD(2) t=<SIGNED> <SHORT>
        { return IntegerTypeRef.shortRef(location(t)); }
    | LOOKAHEAD(4) t=<SIGNED> <LONG> <LONG> <INT>
        { return IntegerTypeRef.longlongRef(location(t)); }
    | LOOKAHEAD(3) t=<SIGNED> <LONG> <LONG>
        { return IntegerTypeRef.longlongRef(location(t)); }
    | LOOKAHEAD(3) t=<SIGNED> <LONG> <INT>
        { return IntegerTypeRef.longRef(location(t)); }
    | LOOKAHEAD(2) t=<SIGNED> <LONG>
        { return IntegerTypeRef.longRef(location(t)); }
    | LOOKAHEAD(2) t=<SIGNED> <INT>
        { return IntegerTypeRef.intRef(location(t)); }
    | t=<SIGNED>
        { return IntegerTypeRef.intRef(location(t)); }
    // "unsigned ..." -- bare "unsigned" alone means "unsigned int".
    | LOOKAHEAD(2) t=<UNSIGNED> <CHAR>
        { return IntegerTypeRef.ucharRef(location(t)); }
    | LOOKAHEAD(3) t=<UNSIGNED> <SHORT> <INT>
        { return IntegerTypeRef.ushortRef(location(t)); }
    | LOOKAHEAD(2) t=<UNSIGNED> <SHORT>
        { return IntegerTypeRef.ushortRef(location(t)); }
    | LOOKAHEAD(4) t=<UNSIGNED> <LONG> <LONG> <INT>
        { return IntegerTypeRef.ulonglongRef(location(t)); }
    | LOOKAHEAD(3) t=<UNSIGNED> <LONG> <LONG>
        { return IntegerTypeRef.ulonglongRef(location(t)); }
    | LOOKAHEAD(3) t=<UNSIGNED> <LONG> <INT>
        { return IntegerTypeRef.ulongRef(location(t)); }
    | LOOKAHEAD(2) t=<UNSIGNED> <LONG>
        { return IntegerTypeRef.ulongRef(location(t)); }
    | LOOKAHEAD(2) t=<UNSIGNED> <INT>
        { return IntegerTypeRef.uintRef(location(t)); }
    | t=<UNSIGNED>
        { return IntegerTypeRef.uintRef(location(t)); }
    // No "signed"/"unsigned" prefix at all.
    | t=<CHAR>          { return IntegerTypeRef.charRef(location(t)); }
    | LOOKAHEAD(2) t=<SHORT> <INT>
        { return IntegerTypeRef.shortRef(location(t)); }
    | t=<SHORT>         { return IntegerTypeRef.shortRef(location(t)); }
    | LOOKAHEAD(3) t=<LONG> <LONG> <INT>
        { return IntegerTypeRef.longlongRef(location(t)); }
    | LOOKAHEAD(2) t=<LONG> <LONG>
        { return IntegerTypeRef.longlongRef(location(t)); }
    | LOOKAHEAD(2) t=<LONG> <INT>
        { return IntegerTypeRef.longRef(location(t)); }
    | t=<LONG>          { return IntegerTypeRef.longRef(location(t)); }
    | t=<INT>           { return IntegerTypeRef.intRef(location(t)); }
}
// #@@}

// #@@range/typedef{
TypedefNode typedef():
{
    Token t;
    TypeRef ref;
    Token newname;
    List<Long> dims;
}
{
    t=<TYPEDEF> ref=typeref() newname=<IDENTIFIER> dims=arraySuffix() ";"
        {
            if (! dims.isEmpty()) {
                ref = withArrayDims(ref, dims);
            }
            addType(newname.image);
            return new TypedefNode(location(t), ref, newname.image);
        }
}
// #@@}

// #@@range/stmts{
List<StmtNode> stmts():
{
    List<StmtNode> ss = new ArrayList<StmtNode>();
    StmtNode s;
}
{
    (s=stmt() { if (s != null) ss.add(s); })*
        {
            return ss;
        }
}
// #@@}

// #@@range/stmt{
StmtNode stmt():
{
    StmtNode n = null;
    ExprNode e = null;
    Token t;
}
{
    ( t=";"
        {
            // A bare "；" -- C's own "empty statement", extremely
            // common as a for/while/do-while loop's whole body (e.g.
            // "for (...) ;") or just a stray semicolon -- used to
            // leave "n" as null instead of returning an actual node,
            // crashing the very first visitor to walk this statement
            // (Cannot invoke "StmtNode.accept" because "<parameter1>"
            // is null) the moment one was ever reached. An empty
            // block has exactly the right semantics (does nothing)
            // and is already handled correctly everywhere a block is.
            n = new BlockNode(location(t), new ArrayList<DefinedVariable>(),
                    new ArrayList<StmtNode>());
        }
    | LOOKAHEAD(2) n=labeled_stmt()
    | e=expr() ";" { n = new ExprStmtNode(e.location(), e); }
    | n=block()
    | n=if_stmt()
    | n=while_stmt()
    | n=dowhile_stmt()
    | n=for_stmt()
    | n=switch_stmt()
    | n=break_stmt()
    | n=continue_stmt()
    | n=goto_stmt()
    | n=return_stmt()
    )
        {
            return n;
        }
}
// #@@}

LabelNode labeled_stmt():
{
    Token t;
    StmtNode n;
}
{
    t=<IDENTIFIER> ":" n=stmt()
        {
            return new LabelNode(location(t), t.image, n);
        }
}

// #@@range/if_stmt{
IfNode if_stmt():
{
    Token t;
    ExprNode cond;
    StmtNode thenBody, elseBody = null;
}
{
    t=<IF> "(" cond=expr() ")" thenBody=stmt()
            [LOOKAHEAD(1) <ELSE> elseBody=stmt()]
        {
            return new IfNode(location(t), cond, thenBody, elseBody);
        }
}
// #@@}

// #@@range/while_stmt{
WhileNode while_stmt():
{
    Token t;
    ExprNode cond;
    StmtNode body;
}
{
    t=<WHILE> "(" cond=expr() ")" body=stmt()
        {
            return new WhileNode(location(t), cond, body);
        }
}
// #@@}

DoWhileNode dowhile_stmt():
{
    Token t;
    ExprNode cond;
    StmtNode body;
}
{
    t=<DO> body=stmt() <WHILE> "(" cond=expr() ")" ";"
        {
            return new DoWhileNode(location(t), body, cond);
        }
}

// A for-loop's init-clause can be a declaration (C99), e.g.
// "for (int i = 0; i < n; i++)"; the declared variable(s) must only be
// visible for the loop (not the enclosing block) and initialize before
// the loop's first condition check, so this desugars to exactly what
// that C99 form means: a block containing the declaration(s) followed
// by the loop itself (with an empty init-clause, since the declaration
// already initialized the variable) -- reusing BlockNode's existing
// scope/initializer machinery rather than adding a new one to ForNode.
StmtNode for_stmt():
{
    Token t;
    List<DefinedVariable> initDecls = null;
    ExprNode init = null, cond = null, incr = null;
    StmtNode body;
}
{
    t=<FOR> "("
              ( LOOKAHEAD(storage() type() <IDENTIFIER>)
                initDecls=defvars_body()
              | [init=expr()]
              )
              ";"
              [cond=expr()] ";"
              [incr=expr()] ")" body=stmt()
        {
            ForNode forNode = new ForNode(location(t), init, cond, incr, body);
            if (initDecls == null) {
                return forNode;
            }
            List<StmtNode> blockStmts = new ArrayList<StmtNode>();
            for (DefinedVariable v : initDecls) {
                if (v.hasInitializer()) {
                    blockStmts.add(new DefvarNode(v));
                }
            }
            blockStmts.add(forNode);
            return new BlockNode(location(t), initDecls, blockStmts);
        }
}

SwitchNode switch_stmt():
{
    Token t;
    ExprNode cond;
    List<CaseNode> bodies;
}
{
    t=<SWITCH> "(" cond=expr() ")" "{" bodies=case_clauses() "}"
        {
            return new SwitchNode(location(t), cond, bodies);
        }
}

List<CaseNode> case_clauses():
{
    List<CaseNode> clauses = new ArrayList<CaseNode>();
    CaseNode n;
}
{
    (n=case_clause() { clauses.add(n); })*
            [n=default_clause() { clauses.add(n); }]
        {
            return clauses;
        }
}

CaseNode case_clause():
{
    List<ExprNode> values;
    BlockNode body;
}
{
    values=cases() body=case_body()
        {
            return new CaseNode(body.location(), values, body);
        }
}

List<ExprNode> cases():
{
    List<ExprNode> values = new ArrayList<ExprNode>();
    ExprNode n;
}
{
    (<CASE> n=primary() ":" { values.add(n); })+
        {
            return values;
        }
}

CaseNode default_clause():
{ BlockNode body; }
{
    <DEFAULT_> ":" body=case_body()
        {
            return new CaseNode(body.location(), new ArrayList<ExprNode>(), body);
        }
}

BlockNode case_body():
{
    LinkedList<StmtNode> stmts = new LinkedList<StmtNode>();
    StmtNode s;
    Token t;
}
{
        { t = getToken(1); }
    (s=stmt() { if (s != null) stmts.add(s); })*
        {
            // A case clause with no "break" at the end falls through
            // into the next one, same as real C switch statements (see
            // IRGenerator#visit(SwitchNode): case bodies are already
            // emitted as one straight-line sequence of labeled
            // statements, so falling through was always what the IR
            // naturally did here -- only this "must end in break" parser
            // restriction ever prevented it).
            return new BlockNode(location(t),
                                 new ArrayList<DefinedVariable>(),
                                 stmts);
        }
}

GotoNode goto_stmt():
{ Token t, name; }
{
    t=<GOTO> name=<IDENTIFIER> ";"
        {
            return new GotoNode(location(t), name.image);
        }
}

// #@@range/break_stmt{
BreakNode break_stmt():
{ Token t; }
{
    t=<BREAK> ";" { return new BreakNode(location(t)); }
}
// #@@}

ContinueNode continue_stmt():
{ Token t; }
{
    t=<CONTINUE> ";" { return new ContinueNode(location(t)); }
}

ReturnNode return_stmt():
{
    Token t;
    ExprNode expr;
}
{
      LOOKAHEAD(2) t=<RETURN> ";" { return new ReturnNode(location(t), null); }
    | t=<RETURN> expr=expr() ";"  { return new ReturnNode(location(t), expr); }
}

// #@@range/expr{
ExprNode expr():
{
    ExprNode lhs, rhs, expr;
    String op;
}
{
      LOOKAHEAD(term() "=")
      lhs=term() "=" rhs=expr()
        {
            return new AssignNode(lhs, rhs);
        }
    | LOOKAHEAD(term() opassign_op())
      lhs=term() op=opassign_op() rhs=expr()
        {
            return new OpAssignNode(lhs, op, rhs);
        }
    | expr=expr10()
        {
            return expr;
        }
}
// #@@}

// #@@range/opassign_op{
String opassign_op(): {}
{
    ( "+="  { return "+"; }
    | "-="  { return "-"; }
    | "*="  { return "*"; }
    | "/="  { return "/"; }
    | "%="  { return "%"; }
    | "&="  { return "&"; }
    | "|="  { return "|"; }
    | "^="  { return "^"; }
    | "<<=" { return "<<"; }
    | ">>=" { return ">>"; }
    )
}
// #@@}

// #@@range/expr10{
ExprNode expr10():
{ ExprNode c, t, e; }
{
    c=expr9() ["?" t=expr() ":" e=expr10()
                    { return new CondExprNode(c, t, e); }]
        {
            return c;
        }
}
// #@@}

// #@@range/expr9{
ExprNode expr9():
{ ExprNode l, r; }
{
    l=expr8() ("||" r=expr8() { l = new LogicalOrNode(l, r); })*
        {
            return l;
        }
}
// #@@}

// #@@range/expr8{
ExprNode expr8():
{ ExprNode l, r; }
{
    l=expr7() ("&&" r=expr7() { l = new LogicalAndNode(l, r); })*
        {
            return l;
        }
}
// #@@}

// #@@range/expr7{
// Bitwise OR/XOR/AND (expr7/expr6/expr5) bind LOOSER than equality
// (expr4), which itself binds LOOSER than relational (expr3) -- e.g.
// "x & y == 0" is (in real C, and here) "x & (y == 0)", not
// "(x & y) == 0", and "a < b & c >= d" is "(a<b) & (c>=d)", not
// "(a < (b&c)) >= d" -- matching C99 6.5's own precedence table
// exactly (relational binds tighter than equality, which binds
// tighter than "&", which binds tighter than "^", which binds tighter
// than "|"). This used to have relational and equality merged into a
// single left-to-right chain (a single "expr7") sitting ABOVE "|"/"^"/
// "&" in this recursive-descent chain -- i.e. binding LOOSER than all
// three -- which is backwards for "&"/"^" specifically: any
// expression mixing a relational/equality comparison with a bitwise
// operator, without fully parenthesizing every comparison, silently
// parsed as an entirely different expression tree and computed the
// wrong value.
ExprNode expr7():
{ ExprNode l, r; }
{
    l=expr6() ("|" r=expr6() { l = new BinaryOpNode(l, "|", r); })*
        {
            return l;
        }
}
// #@@}

// #@@range/expr6{
ExprNode expr6():
{ ExprNode l, r; }
{
    l=expr5() ("^" r=expr5() { l = new BinaryOpNode(l, "^", r); })*
        {
            return l;
        }
}
// #@@}

// #@@range/expr5{
ExprNode expr5():
{ ExprNode l, r; }
{
    l=expr4() ("&" r=expr4() { l = new BinaryOpNode(l, "&", r); })*
        {
            return l;
        }
}
// #@@}

// #@@range/expr4{
ExprNode expr4():
{ ExprNode l, r; }
{
    l=expr3() ( "==" r=expr3() { l = new BinaryOpNode(l, "==", r); }
              | "!=" r=expr3() { l = new BinaryOpNode(l, "!=", r); } )*
        {
            return l;
        }
}
// #@@}

// #@@range/expr3{
ExprNode expr3():
{ ExprNode l, r; }
{
    l=expr2() ( ">"  r=expr2() { l = new BinaryOpNode(l, ">", r); }
              | "<"  r=expr2() { l = new BinaryOpNode(l, "<", r); }
              | ">=" r=expr2() { l = new BinaryOpNode(l, ">=", r); }
              | "<=" r=expr2() { l = new BinaryOpNode(l, "<=", r); } )*
        {
            return l;
        }
}
// #@@}

// #@@range/expr2{
ExprNode expr2():
{ ExprNode l, r; }
{
    l=expr1() ( ">>" r=expr1() { l = new BinaryOpNode(l, ">>", r); }
              | "<<" r=expr1() { l = new BinaryOpNode(l, "<<", r); }
              )*
        {
            return l;
        }
}
// #@@}

// #@@range/expr1{
ExprNode expr1():
{ ExprNode l, r; }
{
    l=expr0() ( "+" r=expr0() { l = new BinaryOpNode(l, "+", r); }
              | "-" r=expr0() { l = new BinaryOpNode(l, "-", r); }
              )*
        {
            return l;
        }
}
// #@@}

// #@@range/expr0{
ExprNode expr0():
{ ExprNode l, r; }
{
    l=term() ( "*" r=term() { l = new BinaryOpNode(l, "*", r); }
             | "/" r=term() { l = new BinaryOpNode(l, "/", r); }
             | "%" r=term() { l = new BinaryOpNode(l, "%", r); }
             )*
        {
            return l;
        }
}
// #@@}

// #@@range/term{
ExprNode term():
{
    TypeNode t;
    ExprNode n;
    AggregateLiteralNode lit;
}
{
      // A C99 compound literal, "(type){...}", looks exactly like a cast
      // up through the closing ")" -- the brace right after it is what
      // tells the two apart, hence the more specific lookahead tried
      // first.
      LOOKAHEAD("(" type() ")" "{")
      "(" t=type() ")" lit=aggregate_literal()
        { n = new CompoundLiteralNode(t, lit); }
      n=postfix_suffixes(n)
        {
            return n;
        }
    | LOOKAHEAD("(" type())
      "(" t=type() ")" n=term()     { return new CastNode(t, n); }
    | n=unary()                     { return n; }
}
// #@@}

// #@@range/unary{
ExprNode unary():
{
    ExprNode n;
    TypeNode t;
}
{
      "++" n=unary()    { return new PrefixOpNode("++", n); }
    | "--" n=unary()    { return new PrefixOpNode("--", n); }
    | "+" n=term()      { return new UnaryOpNode("+", n); }
    | "-" n=term()      { return new UnaryOpNode("-", n); }
    | "!" n=term()      { return new UnaryOpNode("!", n); }
    | "~" n=term()      { return new UnaryOpNode("~", n); }
    | "*" n=term()      { return new DereferenceNode(n); }
    | "&" n=term()      { return new AddressNode(n); }
    | LOOKAHEAD(3) <SIZEOF> "(" t=type() ")"
        {
            return new SizeofTypeNode(t, size_t());
        }
    | <SIZEOF> n=unary()
        {
            return new SizeofExprNode(n, size_t());
        }
    | n=postfix()       { return n; }
}
// #@@}

// #@@range/postfix{
ExprNode postfix():
{ ExprNode expr; }
{
    expr=primary() expr=postfix_suffixes(expr)
        {
            return expr;
        }
}
// #@@}

// The "++"/"--"/"[]"/"."/"->"/"(...)" suffix chain that can follow any
// postfix-expression -- factored out so a compound literal (term(), not
// primary(), since it needs its own lookahead against a plain cast) gets
// the exact same suffix handling as everything else, e.g.
// "(struct point){1,2}.x" or "(struct point[2]){{1,2},{3,4}}[1].y".
ExprNode postfix_suffixes(ExprNode expr):
{
    ExprNode idx;
    String memb;
    List<ExprNode> args;
}
{
    ( "++"                  { expr = new SuffixOpNode("++", expr); }
    | "--"                  { expr = new SuffixOpNode("--", expr); }
    | "[" idx=expr() "]"    { expr = new ArefNode(expr, idx); }
    | "." memb=name()       { expr = new MemberNode(expr, memb); }
    | "->" memb=name()      { expr = new PtrMemberNode(expr, memb); }
    | "(" args=args() ")"   { expr = new FuncallNode(expr, args); }
    )*
        {
            return expr;
        }
}

// #@@range/name{
String name():
{ Token t; }
{
    t=<IDENTIFIER> { return t.image; }
}
// #@@}

// #@@range/arraySuffix{
// Zero or more "[N]"/"[]" groups directly after a declared name (e.g.
// "arr[2]", "matrix[2][3]", a bare "flexible[]" as the last struct
// member) -- see withArrayDims() for why this can't just live inside
// typeref()'s own postfix loop, which runs *before* the name.
List<Long> arraySuffix():
{
    List<Long> dims = new ArrayList<Long>();
    Token t;
}
{
    ( LOOKAHEAD(2) "[" "]"
        { dims.add(null); }
    | "[" t=<INTEGER> "]"
        { dims.add(new Long(integerValue(t.image))); }
    )*
        { return dims; }
}
// #@@}

// #@@range/args{
List<ExprNode> args():
{
    List<ExprNode> args = new ArrayList<ExprNode>();
    ExprNode arg;
}
{
    [ arg=expr() { args.add(arg); }
      ("," arg=expr() { args.add(arg); })* ]
        {
            return args;
        }
}
// #@@}

// #@@range/primary{
ExprNode primary():
{
    Token t, first;
    ExprNode n;
    StringBuffer str;
}
{
      t=<INTEGER>
        {
            return integerNode(location(t), t.image);
        }
    | t=<FLOATLIT>
        {
            return floatNode(location(t), t.image);
        }
    | t=<CHARACTER>
        {
            return new IntegerLiteralNode(location(t),
                                          IntegerTypeRef.charRef(),
                                          characterCode(t.image));
        }
    | t=<STRING>
        {
            // Adjacent string literals concatenate into one, C99 6.4.5p5,
            // e.g. "abc" "def" is the same as "abcdef" -- most often seen
            // spreading one long literal across lines, or built up by a
            // macro that stringifies part of it.
            first = t;
            str = new StringBuffer(stringValue(t.image));
        }
      ( t=<STRING> { str.append(stringValue(t.image)); } )*
        {
            return new StringLiteralNode(location(first),
                new PointerTypeRef(IntegerTypeRef.charRef()),
                str.toString());
        }
    | t=<IDENTIFIER>
        {
            return new VariableNode(location(t), t.image);
        }
    | "(" n=expr() ")"
        {
            return n;
        }
}
// #@@}
